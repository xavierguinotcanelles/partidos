  "requiere_fuente": false,
  "campos": [
    {
      "nombre": "id",
      "tipo": "texto",
      "obligatorio": true,
      "patron": "^[a-z0-9_]+$"
    },
    {
      "nombre": "tabla",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "relaciones",
        "organizaciones"
      ]
    },
    {
      "nombre": "fila",
      "tipo": "texto",
      "obligatorio": true
    },
    {
      "nombre": "fuentes",
      "tipo": "lista",
      "referencia": "fuentes",
      "obligatorio": true
    }
  ]
}
