      "tipo": "texto",
      "valores": [
        "exacta",
        "mes",
        "anio",
        "aprox"
      ]
    },
    {
      "nombre": "hasta",
      "tipo": "fecha"
    },
    {
      "nombre": "hasta_precision",
      "tipo": "texto",
      "valores": [
        "exacta",
        "mes",
        "anio",
        "aprox"
      ]
    },
    {
      "nombre": "estado",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "confirmado",
        "dudoso",
        "en_disputa"
      ]
    },
    {
      "nombre": "nota",
      "tipo": "texto"
    }
  ]
}
