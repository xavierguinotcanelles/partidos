      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "circunscripcion",
        "estatal"
      ]
    },
    {
      "nombre": "escanos_total",
      "tipo": "entero",
      "obligatorio": true
    },
    {
      "nombre": "convocatoria_norma",
      "tipo": "texto",
      "descripcion": "Cita de la norma de convocatoria, p. ej. Real Decreto 806/2026"
    },
    {
      "nombre": "nota",
      "tipo": "texto"
    }
  ]
}
