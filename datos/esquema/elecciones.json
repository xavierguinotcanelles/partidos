    },
    {
      "nombre": "tipo",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "generales",
        "autonomicas",
        "municipales",
        "europeas"
      ]
    },
    {
      "nombre": "institucion",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "congreso"
      ]
    },
    {
      "nombre": "fecha",
      "tipo": "fecha",
      "obligatorio": true
    },
    {
      "nombre": "formula",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "dhondt",
        "sainte_lague",
        "hare"
      ]
    },
    {
      "nombre": "barrera_pct",
      "tipo": "decimal",
      "obligatorio": true
    },
    {
      "nombre": "barrera_base",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "validos",
        "emitidos",
