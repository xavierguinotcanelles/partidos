{
  "entidad": "organizaciones",
  "fichero": "datos/organizaciones/<id>.yaml",
  "descripcion": "Ficha de organización. El id es el nombre del fichero. Tipos: partido, federación, coalición electoral, agrupación de electores, plataforma sin forma jurídica.",
  "requiere_fuente": true,
  "campos": [
    {
      "nombre": "id",
      "tipo": "texto",
      "obligatorio": true,
      "patron": "^[a-z0-9_]+$"
    },
    {
      "nombre": "nombre",
      "tipo": "texto",
      "obligatorio": true
    },
    {
      "nombre": "siglas",
      "tipo": "texto"
    },
    {
      "nombre": "tipo",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "partido",
        "federacion",
        "coalicion",
        "agrupacion_electores",
        "plataforma"
      ]
    },
    {
      "nombre": "ambito",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "estatal",
        "autonomico",
        "provincial",
        "local",
        "supraestatal"
      ]
    },
    {
      "nombre": "alta",
      "tipo": "fecha"
    },
    {
      "nombre": "alta_precision",
      "tipo": "texto",
      "valores": [
        "exacta",
        "mes",
        "anio",
        "aprox"
      ]
    },
    {
      "nombre": "baja",
      "tipo": "fecha"
    },
    {
      "nombre": "baja_precision",
      "tipo": "texto",
      "valores": [
        "exacta",
        "mes",
        "anio",
        "aprox"
      ]
    },
    {
      "nombre": "registro",
      "tipo": "texto",
      "descripcion": "Número o referencia de inscripción en el Registro de Partidos Políticos"
    },
    {
      "nombre": "color",
      "tipo": "texto",
      "patron": "^(#[0-9a-fA-F]{6})?$",
      "descripcion": "Color de identificación en la web; su elección se documenta en nota o fuente"
    },
    {
      "nombre": "wikidata",
      "tipo": "texto",
      "patron": "^(Q\\d+)?$"
    },
    {
      "nombre": "wikidata_otros",
      "tipo": "lista",
      "patron_elemento": "^Q\\d+$",
      "descripcion": "Otras entradas de Wikidata de la misma organización (ADR-0022); la principal va en 'wikidata'"
    },
    {
      "nombre": "nombres",
      "tipo": "lista_objetos",
      "descripcion": "Nombres fechados de la organización (ADR-0022); 'nombre' y 'siglas' de la ficha son los del último",
      "campos": [
        {
          "nombre": "nombre",
          "tipo": "texto",
          "obligatorio": true
        },
        {
          "nombre": "siglas",
          "tipo": "texto"
        },
        {
          "nombre": "desde",
          "tipo": "fecha"
        },
        {
          "nombre": "desde_precision",
          "tipo": "texto",
          "valores": [
            "exacta",
            "mes",
            "anio",
            "aprox"
          ]
        },
        {
          "nombre": "hasta",
          "tipo": "fecha"
        },
        {
          "nombre": "hasta_precision",
          "tipo": "texto",
          "valores": [
            "exacta",
            "mes",
            "anio",
            "aprox"
          ]
        },
        {
          "nombre": "nota",
          "tipo": "texto"
        }
      ]
    },
    {
      "nombre": "estado",
      "tipo": "texto",
      "obligatorio": true,
      "valores": [
        "confirmado",
        "dudoso",
        "en_disputa"
      ]
    },
    {
      "nombre": "justificacion",
      "tipo": "texto",
      "referencia": "justificaciones",
      "descripcion": "Id de datos/justificaciones/<id>.md (ADR-0022)"
    },
    {
      "nombre": "fuentes",
      "tipo": "lista",
      "referencia": "fuentes",
      "descripcion": "Ids de fuentes; alternativa a filas en fuente_de (al menos una de las dos)"
    },
    {
      "nombre": "notas",
      "tipo": "texto"
    }
  ]
}
